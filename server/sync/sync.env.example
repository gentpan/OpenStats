# OpenStats 同步服务配置，放在 /etc/openstats/sync.env（root:openstats-sync，权限 640）。
# 没填的登录方式不会出现在应用里。

# 对外地址，回调地址由此拼出：https://getopenstats.com/api/v1/auth/<provider>/callback
SYNC_BASE_URL=https://getopenstats.com
SYNC_LISTEN=127.0.0.1:8787

# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               https://getopenstats.com
#   Authorization callback URL: https://getopenstats.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID（Web application）
#   Authorized redirect URI:    https://getopenstats.com/api/v1/auth/google/callback
# OAuth consent screen 需要填隐私政策链接：https://getopenstats.com/privacy.html
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer → Certificates, Identifiers & Profiles
#   1. Identifiers → App IDs → com.openstats.app 打开 Sign in with Apple
#   2. Identifiers → Services IDs → 新建（例如 com.openstats.web），配置 Sign in with Apple：
#        Domains: getopenstats.com   Return URLs: https://getopenstats.com/api/v1/auth/apple/callback
#   3. Keys → 新建带 Sign in with Apple 的 Key，下载 .p8 放到 /etc/openstats/apple-signin.p8
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=/etc/openstats/apple-signin.p8
